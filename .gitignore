# Game logs and the viewer built from them live in R2 (divinci-experiments/commander/<run>/),
# not git — 179 MB for one day of runs. scripts/fetch-games.sh restores them.
harness/games/
harness/viewer.html
harness/*.log
__pycache__/
*.pyc
.venv/
.DS_Store
.wrangler/

cloud/node_modules
cloud/.wrangler
cloud/.dev.vars

# written by scripts/cloud_deploy.sh before each image build
table/BUILD_SHA
scripts/printer/watch/

# dogfood loop results: game folders hold private hands and full logs; only reports are shared deliberately
harness/results/*/game-*/
harness/results/*/current.*

# Card art is copyrighted: never in the repo (review S4). The table serves it from TABLE_ART_DIR.
table/assets/art/
table/assets/art-index.js

# The table's local state. table/.cache holds the Oracle download AND every game's research record
# (private hands, full logs, invite codes): a stray `git add .` must never publish it.
table/.cache/
table/.cache
# a game's live folder, seat keys and tokens, saved games, and keys of any kind
live/
saves/
*.pkl
*.key
*.pem
*.token
*token*.txt
*-seat.key
*-link.txt
.env
.env.*
node_modules/

# the draft tests write results here
draft/drafts/
